# ============================================================================
# BuzzDM - Environment Configuration Template
# ============================================================================
# Copy this file to .env and configure your values
# NEVER commit .env to version control!
# ============================================================================

# Database Configuration
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_secure_password

# Application Settings
APP_ENV=production
APP_DEBUG=false
# Full URL where the app is reachable (links, emails, redirects). E.g. https://yourdomain.com or http://localhost/buzzdm
APP_URL=https://yourdomain.com

# Secrets required by CLI/cron entry points. Generate with: php -r "echo bin2hex(random_bytes(32));"
# Leave EMPTY in production unless the corresponding endpoint is actively used.
# An endpoint that receives an empty secret REJECTS the request instead of accepting it.
CRON_SECRET_KEY=

# Backup Settings
BACKUP_PATH=../backups
BACKUP_RETENTION_DAYS=30
# MUST be a random 32+ char string. Leaving it empty disables the backup endpoints,
# which is safer than shipping a predictable placeholder.
BACKUP_SECRET_TOKEN=
# Set to 1 ONLY if your certificate is self-signed (typical on local XAMPP).
# Leave empty/0 in production so outgoing HTTPS calls are verified.
BACKUP_SKIP_TLS_VERIFY=

# Rate limiting
# Only set this if the app runs behind a proxy/CDN: comma-separated exact IPs or
# CIDR ranges of proxies YOU control. The login rate limiter will only read the
# real client IP from X-Forwarded-For when REMOTE_ADDR is listed here.
# Leave EMPTY to always use REMOTE_ADDR (safest: the client cannot forge it),
# at the cost of counting every user behind the same proxy as a single IP.
RATE_LIMIT_PROXIES=

# Email Configuration (for password recovery)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=your_email@domain.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=BuzzDM
