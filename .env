# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_URL=
# Al ejecutar en localhost, se debe usar la siguiente URL: http://localhost/BuzzDM
APP_URL=http://localhost/BuzzDM
# Al ejecutar la app en Hostinger, APP_URL puede quedar vacío. O puede ser comentado.

# Backup Settings
