import { Chart } from "@/components/ui/chart"
// Dashboard specific functionality
document.addEventListener("DOMContentLoaded", () => {
  initDashboard()
})

function initDashboard() {
  loadStats()
  initSalesChart()
  loadActivityLog()
  loadTopProducts()
  loadLowStockProducts()
}

function loadStats() {
  // Simulate loading stats from API
  const stats = {
    totalProducts: 1247,
    totalOrders: 3892,
    pendingShipments: 156,
    monthlyRevenue: 45780,
  }

  // Animate counters
  animateCounter("totalProducts", stats.totalProducts)
  animateCounter("totalOrders", stats.totalOrders)
  animateCounter("pendingShipments", stats.pendingShipments)
  animateCounter("monthlyRevenue", stats.monthlyRevenue, true)
}

function animateCounter(elementId, targetValue, isCurrency = false) {
  const element = document.getElementById(elementId)
  if (!element) return

  let currentValue = 0
  const increment = targetValue / 100
  const timer = setInterval(() => {
    currentValue += increment
    if (currentValue >= targetValue) {
      currentValue = targetValue
      clearInterval(timer)
    }

    if (isCurrency) {
      element.textContent = formatCurrency(Math.floor(currentValue))
    } else {
      element.textContent = Math.floor(currentValue).toLocaleString("es-ES")
    }
  }, 20)
}

function initSalesChart() {
  const ctx = document.getElementById("salesChart")
  if (!ctx) return

  // Sample data for the last 30 days
  const labels = []
  const data = []
  const now = new Date()

  for (let i = 29; i >= 0; i--) {
    const date = new Date(now)
    date.setDate(date.getDate() - i)
    labels.push(date.toLocaleDateString("es-ES", { month: "short", day: "numeric" }))
    data.push(Math.floor(Math.random() * 1000) + 500)
  }

  new Chart(ctx, {
    type: "line",
    data: {
      labels: labels,
      datasets: [
        {
          label: "Ventas Diarias",
          data: data,
          borderColor: "#FFA000",
          backgroundColor: "rgba(255, 160, 0, 0.1)",
          borderWidth: 2,
          fill: true,
          tension: 0.4,
        },
      ],
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          labels: {
            color: "#c9d1d9",
            font: {
              family: "Roboto Mono",
            },
          },
        },
      },
      scales: {
        x: {
          ticks: {
            color: "#8b949e",
            font: {
              family: "Roboto Mono",
            },
          },
          grid: {
            color: "#343a40",
          },
        },
        y: {
          ticks: {
            color: "#8b949e",
            font: {
              family: "Roboto Mono",
            },
          },
          grid: {
            color: "#343a40",
          },
        },
      },
    },
  })
}

function loadActivityLog() {
  const activityLog = document.getElementById("activityLog")
  if (!activityLog) return

  const activities = [
    { time: "09:23", user: "admin", action: "Nuevo pedido #1247 creado", type: "success" },
    { time: "09:15", user: "vendedor1", action: "Producto SKU-001 actualizado", type: "info" },
    { time: "09:08", user: "admin", action: "Stock bajo detectado en 3 productos", type: "warning" },
    { time: "08:45", user: "sistema", action: "Backup automático completado", type: "success" },
    { time: "08:30", user: "vendedor2", action: "Pedido #1246 marcado como enviado", type: "info" },
    { time: "08:12", user: "admin", action: "Usuario nuevo registrado", type: "success" },
  ]

  activityLog.innerHTML = activities
    .map(
      (activity) => `
        <div class="d-flex align-items-start mb-3 pb-2 border-bottom border-secondary">
            <div class="me-3">
                <i class="fas fa-${getActivityIcon(activity.type)} text-${activity.type === "success" ? "success" : activity.type === "warning" ? "warning" : "primary"}"></i>
            </div>
            <div class="flex-grow-1">
                <div class="font-mono" style="font-size: 0.9rem;">${activity.action}</div>
                <small class="text-muted">
                    ${activity.time} - Usuario: ${activity.user}
                </small>
            </div>
        </div>
    `,
    )
    .join("")
}

function getActivityIcon(type) {
  switch (type) {
    case "success":
      return "check-circle"
    case "warning":
      return "exclamation-triangle"
    case "error":
      return "times-circle"
    default:
      return "info-circle"
  }
}

function loadTopProducts() {
  const topProducts = document.getElementById("topProducts")
  if (!topProducts) return

  const products = [
    { name: "Laptop Gaming Pro", sales: 156, revenue: 234000 },
    { name: "Mouse Inalámbrico", sales: 289, revenue: 17340 },
    { name: "Teclado Mecánico", sales: 198, revenue: 29700 },
    { name: "Monitor 4K", sales: 87, revenue: 52200 },
    { name: "Auriculares Premium", sales: 145, revenue: 21750 },
  ]

  topProducts.innerHTML = products
    .map(
      (product, index) => `
        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 ${index < products.length - 1 ? "border-bottom border-secondary" : ""}">
            <div class="d-flex align-items-center">
                <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 30px; height: 30px; font-size: 0.8rem;">
                    ${index + 1}
                </div>
                <div>
                    <div class="font-mono" style="font-size: 0.9rem;">${product.name}</div>
                    <small class="text-muted">${product.sales} unidades vendidas</small>
                </div>
            </div>
            <div class="text-end">
                <div class="text-primary font-mono">${formatCurrency(product.revenue)}</div>
            </div>
        </div>
    `,
    )
    .join("")
}

function loadLowStockProducts() {
  const lowStockProducts = document.getElementById("lowStockProducts")
  if (!lowStockProducts) return

  const products = [
    { sku: "LAP-001", name: "Laptop Gaming Pro", stock: 3, minStock: 10 },
    { sku: "MOU-005", name: "Mouse Inalámbrico", stock: 7, minStock: 20 },
    { sku: "KEY-003", name: "Teclado Mecánico", stock: 2, minStock: 15 },
    { sku: "MON-002", name: "Monitor 4K", stock: 1, minStock: 5 },
  ]

  lowStockProducts.innerHTML = products
    .map(
      (product, index) => `
        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 ${index < products.length - 1 ? "border-bottom border-secondary" : ""}">
            <div>
                <div class="font-mono" style="font-size: 0.9rem;">${product.name}</div>
                <small class="text-muted">SKU: ${product.sku}</small>
            </div>
            <div class="text-end">
                <span class="badge badge-${product.stock <= 2 ? "danger" : "warning"}">${product.stock} unidades</span>
            </div>
        </div>
    `,
    )
    .join("")
}

function formatCurrency(value) {
  return new Intl.NumberFormat("es-ES", { style: "currency", currency: "EUR" }).format(value)
}
