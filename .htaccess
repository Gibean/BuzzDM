# ============================================================================
# BuzzDM - Apache Security Configuration
# ============================================================================
# This file provides security headers and access restrictions
# ============================================================================

# ----------------------------------------------------------------------
# Security Headers
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"

    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"

    # Enable XSS Filter
    Header set X-XSS-Protection "1; mode=block"

    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Disable caching for API responses
    <FilesMatch "\.(php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# Protect Sensitive Files
# ----------------------------------------------------------------------

# Block access to .env files
<FilesMatch "^\.env">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block access to debug logs
<Files "debug_log.txt">
    Order Allow,Deny
    Deny from all
</Files>

# Block access to composer files
<FilesMatch "^composer\.(json|lock)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block access to .git directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /BuzzDM/
    RewriteRule ^\.git - [F,L]

    # ----------------------------------------------------------------------
    # Pretty URLs - Remove .php extension
    # ----------------------------------------------------------------------

    # Don't apply to actual files/directories or API endpoints
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/BuzzDM/php/ [NC]
    RewriteCond %{REQUEST_URI} !^/BuzzDM/assets/ [NC]
    RewriteCond %{REQUEST_URI} !^/BuzzDM/vendor/ [NC]

    # If file.php exists, serve it for /file URLs
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([^\.]+)$ $1.php [NC,L]

    # Redirect /file.php to /file (301 redirect for SEO)
    # Only for direct browser requests, not internal rewrites
    # Exclude php/, assets/, vendor/ directories from redirect
    RewriteCond %{THE_REQUEST} \s/+BuzzDM/([^\.]+)\.php[\s?] [NC]
    RewriteCond %{REQUEST_URI} !^/BuzzDM/php/ [NC]
    RewriteCond %{REQUEST_URI} !^/BuzzDM/assets/ [NC]
    RewriteCond %{REQUEST_URI} !^/BuzzDM/vendor/ [NC]
    RewriteRule ^ /BuzzDM/%1 [R=301,L]
</IfModule>

# ----------------------------------------------------------------------
# PHP Settings (if allowed by hosting)
# ----------------------------------------------------------------------
<IfModule mod_php.c>
    # Hide PHP version
    php_flag expose_php Off

    # Disable error display in production
    # php_flag display_errors Off
</IfModule>

# ----------------------------------------------------------------------
# Prevent Directory Listing
# ----------------------------------------------------------------------
Options -Indexes

# ----------------------------------------------------------------------
# Block access to backup files
# ----------------------------------------------------------------------
<FilesMatch "\.(sql|sql\.gz|bak|backup)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ----------------------------------------------------------------------
# Default charset
# ----------------------------------------------------------------------
AddDefaultCharset UTF-8
